{% doc %}
  MALINVO: compact "in the set" strip for the buy box. Four small real product photos with a name each.
  Descriptions live in the "מה בסט" accordion (snippets/mlv-buy-more.liquid).
  @example
  {% render 'mlv-in-the-box' %}
{% enddoc %}
{%- assign fb = '/cdn/shop/files/' -%}
<div class="mlv-box" role="group" aria-labelledby="mlv-box-h">
  <p class="mlv-box__h" id="mlv-box-h">בסט:</p>
  <ul class="mlv-box__grid" role="list">
    <li class="mlv-box__card"><span class="mlv-box__img"><img src="{{ fb }}malinvo_oval_whiteset_02.webp?v=1795094661&width=176" width="176" height="176" loading="lazy" decoding="async" alt="ראש מקלחת אובאלי MALINVO עם פילטר"></span><span class="mlv-box__name">ראש מקלחת אובאלי</span></li>
    <li class="mlv-box__card"><span class="mlv-box__img"><img src="{{ fb }}malinvo_oval_silver_01.webp?v=1795094661&width=176" width="176" height="176" loading="lazy" decoding="async" alt="פילטר פחם פעיל להחלפה"></span><span class="mlv-box__name">פילטר פחם פעיל</span></li>
  </ul>
</div>
<style>
.mlv-box{margin:0;padding:8px 12px;background:#f6efe8;border-radius:14px;color:#0e1d21;direction:rtl;text-align:right}
#mlv .mlv-box__h,.mlv-box__h{margin:0 0 6px;font-size:12px;line-height:16px;font-weight:700;letter-spacing:.04em;color:#8a5233}
#mlv .mlv-box__grid,.mlv-box__grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.mlv-box__card{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;min-width:0}
.mlv-box__img{position:relative;display:block;width:52px;max-width:100%;aspect-ratio:1;overflow:hidden;border-radius:10px;background:#f3ece5}
.mlv-box__img img{position:absolute;inset:3px;display:block;width:calc(100% - 6px);height:calc(100% - 6px);object-fit:contain;object-position:50% 50%}
.mlv-box__name{display:block;font-size:12px;line-height:1.25;font-weight:600}
</style>
