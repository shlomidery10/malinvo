{%- comment -%}
  MALINVO floating WhatsApp button.
  Number + message are theme settings: Theme settings > "MALINVO WhatsApp button".
  A placeholder number is set so the icon is visible now; Shlomi replaces it with the real number.
  Positioned to clear the sticky CTA on the product page (raised above it).
{%- endcomment -%}
{%- assign wa_num = settings.mlv_wa_number | default: settings.mlv_whatsapp | strip -%}
{%- if settings.mlv_wa_enable and wa_num != blank -%}
  {%- assign wa_msg = settings.mlv_wa_message | default: 'היי, יש לי שאלה על ראש המקלחת של MALINVO' -%}
  <a class="mlv-wa{% if template contains 'product' %} mlv-wa--raised{% endif %}"
     href="https://wa.me/{{ wa_num | url_encode }}?text={{ wa_msg | url_encode }}"
     target="_blank" rel="noopener noreferrer"
     aria-label="פנייה בוואטסאפ">
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false" width="30" height="30">
      <path fill="#fff" d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.6c1.7.9 3.7 1.4 5.8 1.4h.1c6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.9c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-4.3.8.9-4.2-.3-.4C5.9 18.3 5.4 16.7 5.4 15 5.4 9.2 10.2 4.4 16 4.4S26.6 9.2 26.6 15 21.8 24.9 16 24.9zm6-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2.1-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.2 4.6.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4z"/>
    </svg>
  </a>
  {%- style -%}
    .mlv-wa{position:fixed;z-index:45;inline-size:56px;block-size:56px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#25D366;box-shadow:0 8px 24px -6px rgba(0,0,0,.45);inset-inline-end:calc(16px + env(safe-area-inset-right));inset-block-end:calc(18px + env(safe-area-inset-bottom));-webkit-tap-highlight-color:transparent;transition:transform 160ms cubic-bezier(.23,1,.32,1)}
    .mlv-wa:hover{transform:scale(1.06)}
    .mlv-wa:active{transform:scale(.96)}
    @media (max-width:749px){
      .mlv-wa--raised{inset-block-end:calc(84px + env(safe-area-inset-bottom))}
    }
    @media (prefers-reduced-motion:reduce){.mlv-wa{transition:none}}
  {%- endstyle -%}
{%- endif -%}
