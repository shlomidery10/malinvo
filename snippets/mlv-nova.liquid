{% doc %}
  MALINVO Nova intro panel: six benefit lines, each with an original inline-SVG icon in brand copper,
  on a soft brand gradient card. Original design and copy (no competitor assets). RTL, mobile-first.
  Works inside the product buy box (narrow) and as a home section (pass wide: true for a 2-column grid).
  Honesty: no water-softener/limescale/health/percentages; "פילטר" not "מחסנית".
  @param {boolean} [wide] - Two columns on desktop (home section). Default single column (buy box).
  @example
  {% render 'mlv-nova' %}
  {% render 'mlv-nova', wide: true %}
{% enddoc %}
<div class="nova">
  <ul class="nova-list{% if wide %} is-wide{% endif %}">
    <li class="nova-row">
      <svg class="nova-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c3.5 4.2 5.5 7.1 5.5 9.8A5.5 5.5 0 0 1 12 18.3a5.5 5.5 0 0 1-5.5-5.5C6.5 10.1 8.5 7.2 12 3z"/><path d="M9 20.5h6M10 22.5h4"/></svg>
      <div><b class="nova-b">זרם מלא וצפוף</b><span class="nova-s">מרגיש חזק, גם כשהלחץ בבית בינוני.</span></div>
    </li>
    <li class="nova-row">
      <svg class="nova-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="3.2" rx="1.4"/><rect x="4" y="10.4" width="16" height="3.2" rx="1.4"/><rect x="4" y="15.8" width="16" height="3.2" rx="1.4"/></svg>
      <div><b class="nova-b">פילטר פחם פעיל, 4 שכבות</b><span class="nova-s">מפחית כלור שיורי, ותופס חול, חלודה ומשקעים מהצנרת.</span></div>
    </li>
    <li class="nova-row">
      <svg class="nova-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 6 12 6s9.5 6 9.5 6-3.5 6-9.5 6S2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.6"/></svg>
      <div><b class="nova-b">רואים מה הפילטר תופס</b><span class="nova-s">מוציאים את הפילטר אחרי שימוש ובודקים בעצמכם.</span></div>
    </li>
    <li class="nova-row">
      <svg class="nova-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4.5a4 4 0 0 0-5 5l-6 6 2.5 2.5 6-6a4 4 0 0 0 5-5l-2.4 2.4-2.1-2.1 2.5-2.3z"/></svg>
      <div><b class="nova-b">מתחבר בדקה</b><span class="nova-s">מתחבר לצינור המקלחת בקלות - בלי כלים ובלי אינסטלטור.</span></div>
    </li>
    <li class="nova-row">
      <svg class="nova-ic" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="6" ry="8.5"/></svg>
      <div><b class="nova-b">עיצוב שחור נקי</b><span class="nova-s">ראש נקי בגימור מט, שלא מסתירים.</span></div>
    </li>
    <li class="nova-row">
      <svg class="nova-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7a8 8 0 0 0-14-1"/><path d="M4 5v4h4"/><path d="M4 17a8 8 0 0 0 14 1"/><path d="M20 19v-4h-4"/></svg>
      <div><b class="nova-b">מחליפים פילטר, לא ראש</b><span class="nova-s">קונים ראש אחד, ומחליפים רק את הפילטר.</span></div>
    </li>
  </ul>
</div>
<style>
  :is(#mlvh) .nova-h{max-width:760px;margin-bottom:20px}
  :is(#mlv,#mlvh) .mlv-pay{display:flex;flex-wrap:wrap;gap:6px;margin:2px 0 0;padding:0;list-style:none}
  :is(#mlv,#mlvh) .mlv-pay li{font-size:.72rem;font-weight:700;letter-spacing:.01em;color:#2a3a3e;border:1px solid #e4ebed;border-radius:7px;padding:4px 9px;background:#fff}
  :is(#mlv,#mlvh) .nova-eyebrow{font-family:"Rubik","Heebo",sans-serif;font-weight:800;font-size:1.15rem;letter-spacing:.02em;line-height:1.2;color:#0e1d21;margin:0 0 6px}
  :is(#mlv,#mlvh) .nova-eyebrow span{color:#b06a3f}
  :is(#mlv,#mlvh) .nova{position:relative;overflow:hidden;border:1px solid #ecdcc9;border-radius:18px;padding:16px;background:linear-gradient(135deg,rgba(176,106,63,.12),rgba(243,239,233,.55));background-color:#fbf6f0}
  :is(#mlv,#mlvh) .nova::before{content:"";position:absolute;inset:0;background:radial-gradient(120% 95% at 88% 0%,rgba(210,128,79,.16),transparent 58%);pointer-events:none}
  :is(#mlv,#mlvh) .nova-list{position:relative;display:grid;grid-template-columns:1fr;gap:12px;margin:0;padding:0;list-style:none}
  :is(#mlv,#mlvh) .nova-row{display:grid;grid-template-columns:40px 1fr;gap:12px;align-items:start;margin:0}
  :is(#mlv,#mlvh) .nova-row{list-style:none}
  :is(#mlv,#mlvh) .nova-ic{width:40px;height:40px;flex:none;padding:8px;border-radius:11px;background:rgba(255,255,255,.75);border:1px solid #eedcca;fill:none;stroke:#b06a3f;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  :is(#mlv,#mlvh) .nova-b{display:block;font-family:"Rubik","Heebo",sans-serif;font-weight:800;font-size:1.02rem;line-height:1.3;color:#0e1d21}
  :is(#mlv,#mlvh) .nova-s{display:block;margin-top:2px;font-size:.9rem;line-height:1.45;color:#2a3a3e}
  @media(min-width:901px){
    :is(#mlvh) .nova{padding:24px clamp(20px,3vw,34px)}
    :is(#mlvh) .nova-list.is-wide{grid-template-columns:1fr 1fr;gap:16px 28px}
  }
</style>
