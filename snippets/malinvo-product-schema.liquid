{%- comment -%} MALINVO Product + Offer (ILS, the single-set price) + BreadcrumbList. No hardcoded rating: review markup must come from the live review data. One Offer per variant. Return and delivery values mirror the published policies (customer pays return shipping; 1-3 business days handling plus up to 15 business days delivery, Sun-Thu). {%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- comment -%} Two sold variants (שחור / לבן); the schema describes the selected one, defaulting to the black set. {%- endcomment -%}
{%- if v == blank -%}{%- for pv in product.variants -%}{%- if pv.title == 'שחור' -%}{%- assign v = pv -%}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": {{ shop.url | append: product.url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "description": {{ product.description | replace: '</', ' </' | replace: '<br', ' <br' | strip_html | strip_newlines | split: ' ' | join: ' ' | truncate: 500 | json }},
      "url": {{ shop.url | append: product.url | json }},
      "image": [{%- assign mv_first = true -%}{%- for m in product.media limit: 6 -%}{%- if m.media_type == 'image' -%}{%- unless mv_first -%},{%- endunless -%}{{ m | image_url: width: 1200 | prepend: 'https:' | json }}{%- assign mv_first = false -%}{%- endif -%}{%- endfor -%}],
      "brand": { "@type": "Brand", "name": "MALINVO" },
      "category": "ראש מקלחת עם פילטר",
      "color": {{ v.title | append: ' מט' | json }},
      "material": "ABS",
      "offers": [
        {%- assign today_num = 'now' | date: '%Y%m%d' | plus: 0 -%}
        {%- for ov in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ ov.title | json }},
          {%- if ov.sku != blank %}
          "sku": {{ ov.sku | json }},
          {%- endif %}
          "priceCurrency": "ILS",
          "price": {{ ov.price | divided_by: 100.0 | json }},
          {%- comment -%} Launch price is valid until 31.12.2026 (published deadline); omitted once that date has passed. {%- endcomment -%}
          {%- if ov.compare_at_price > ov.price and today_num < 20270101 %}
          "priceValidUntil": "2026-12-31",
          {%- endif %}
          "availability": "https://schema.org/{% if ov.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "url": {{ shop.url | append: ov.url | json }},
          "seller": { "@id": {{ shop.url | append: '/#organization' | json }} },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "IL",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": 30,
            "merchantReturnLink": {{ shop.url | append: '/policies/refund-policy' | json }},
            "returnMethod": "https://schema.org/ReturnByMail",
            "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
          },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "IL" },
            "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "ILS" },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "businessDays": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["https://schema.org/Sunday", "https://schema.org/Monday", "https://schema.org/Tuesday", "https://schema.org/Wednesday", "https://schema.org/Thursday"] },
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 5, "maxValue": 15, "unitCode": "DAY" }
            }
          }
        }{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "דף הבית", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
      ]
    }
  ]
}
</script>
