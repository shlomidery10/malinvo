{%- doc -%}
  MALINVO home trust block: brand paragraph, four promises, and contact / business rows that render only when the
  matching theme settings are filled (mlv_whatsapp, mlv_support_email, mlv_business_name, mlv_business_id).
  @example
  {% render 'mlvh-trust' %}
{%- enddoc -%}
{%- assign wa = settings.mlv_whatsapp | remove: ' ' | remove: '-' | remove: '+' | strip -%}
{%- assign mail = settings.mlv_support_email | strip -%}
{%- assign biz = settings.mlv_business_name | strip -%}
{%- assign biz_id = settings.mlv_business_id | strip -%}
<section class="trust sec" id="mlvh-trust">
  <div class="w">
    <h2>מותג ישראלי, מוצר אחד</h2>
    <p class="lead">בחרנו מוצר אחד, ראש מקלחת עם פילטר מתחלף, ועבדנו על המראה, התא השקוף והסט כולו עד שירגיש כמו שדרוג.</p>
    <ul class="proms">
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg><b>משלוח חינם עד הבית</b><span>עם מעקב במייל</span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg><b>30 יום להחליט</b><span>מיום הקבלה</span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><b>תשלום מאובטח</b><span>כרטיס אשראי או PayPal</span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg><b>מענה בעברית</b><span>בימים א׳–ה׳</span></li>
    </ul>
    {%- if wa != blank or mail != blank -%}
      <p class="contact-row">
        {%- if wa != blank -%}<a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">כתבו לנו בוואטסאפ</a>{%- endif -%}
        {%- if mail != blank -%}<a href="mailto:{{ mail | escape }}" dir="ltr">{{ mail | escape }}</a>{%- endif -%}
      </p>
    {%- endif -%}
    {%- if biz != blank -%}
      <p class="biz-row">{{ biz | escape }}</p>
    {%- endif -%}
    <a class="tlink" href="/pages/refund-policy">כל הפרטים במדיניות ההחזרות</a>
  </div>
</section>
