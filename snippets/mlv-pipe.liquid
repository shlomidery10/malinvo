{% doc %}
  MALINVO section 2: "what reaches you from the pipes". Styles live in sections/malinvo-product.liquid (product page)
  and snippets/mlv-sections-css.liquid (home page).
  With images: the infographic already carries the headline and closing line, so the h2 stays for SEO and
  screen readers only. Without images: visible headline + the real chamber photo as a clean placeholder.
  The defaults render the product page version. The home page passes the optional parameters.
  @param {image} [img_m] - Infographic for mobile, 4:5 (up to 749px)
  @param {image} [img_d] - Infographic for desktop, 16:9 (750px and up)
  @param {image} [real_img] - Optional real photo of a used filter
  @param {string} [real_cap] - Caption for the real photo
  @param {string} [real_title] - Title above the caption of the real photo
  @param {image} [chamber_img] - Optional real photo of the clear chamber, shown under the points
  @param {string} [section_id] - Section id (default: mlv-pipe)
  @param {string} [buy_url] - Link to the bundle picker (default: #bundle-up)
  @param {boolean} [hide_points_mobile] - Hide the three numbered points up to 900px (they are in the infographic)
  @param {boolean} [cta_button] - Render the link as a primary button
  @example
  {% render 'mlv-pipe', img_m: section.settings.pipe_image_m, img_d: section.settings.pipe_image_d %}
{% enddoc %}
{%- assign img_wide = img_d | default: img_m -%}
{%- assign img_tall = img_m | default: img_d -%}
{%- assign pipe_id = section_id | default: 'mlv-pipe' -%}
{%- assign pipe_buy = buy_url | default: '#bundle-up' -%}
<section class="pipe sec" id="{{ pipe_id }}">
  <div class="w pipe-g{% if img_tall %} has-img{% endif %}">
    <div class="pipe-h">
      <span class="kick">הדרך של המים</span>
      <h2{% if img_tall %} class="vh"{% endif %}>מה מגיע אליכם מהצנרת</h2>
      {%- unless img_tall -%}<p class="journey-h">עד שהמים מגיעים לילד שלכם, הם כבר עברו הרבה.</p>{%- endunless -%}
    </div>
    {%- if img_tall -%}
      {%- assign pipe_alt = 'המחשה: צינורות מים ישנים וחלודים, עם הכיתוב מה מגיע אליכם מהצנרת' -%}
      <figure class="pipe-m">
        <picture>
          <source media="(min-width:750px)" srcset="{{ img_wide | image_url: width: 1000 }} 1000w, {{ img_wide | image_url: width: 1840 }} 1840w" sizes="(min-width:960px) 920px, 100vw" width="{{ img_wide.width }}" height="{{ img_wide.height }}">
          <img src="{{ img_tall | image_url: width: 800 }}" srcset="{{ img_tall | image_url: width: 500 }} 500w, {{ img_tall | image_url: width: 800 }} 800w, {{ img_tall | image_url: width: 1080 }} 1080w" sizes="100vw" width="{{ img_tall.width }}" height="{{ img_tall.height }}" loading="lazy" decoding="async" alt="{{ pipe_alt }}">
        </picture>
        <figcaption style="position:absolute;bottom:10px;inset-inline-start:12px;margin:0;padding:2px 10px;border-radius:999px;background:rgba(21,35,43,.6);color:#fff;font-size:11px;line-height:1.6">המחשה</figcaption>
      </figure>
    {%- else -%}
      {%- assign ph = images['malinvo_black_03_filter_inside.png'] -%}
      <figure class="pipe-m is-ph">
        <img src="{{ ph | image_url: width: 800 }}" srcset="{{ ph | image_url: width: 500 }} 500w, {{ ph | image_url: width: 800 }} 800w, {{ ph | image_url: width: 1200 }} 1200w" sizes="(min-width:901px) 520px, 100vw" width="{{ ph.width }}" height="{{ ph.height }}" loading="lazy" decoding="async" alt="ראש המקלחת MALINVO Nova השחור עם הפילטר שבתוך הידית">
      </figure>
    {%- endif -%}
    <div class="pipe-p{% if chamber_img %} has-chamber{% endif %}">
      {%- if img_tall -%}<p class="journey-h">עד שהמים מגיעים לילד שלכם, הם כבר עברו הרבה.</p>{%- endif -%}
      <ol class="nums{% if hide_points_mobile %} hide-m{% endif %}">
        <li><div><b>הקו ברחוב</b><span>כלור שמוסיפים בכוונה, כדי שהמים יישארו מחוטאים עד הברז. ואחרי עבודות תשתית בשכונה, גם חול ולכלוך שנכנסו לקו.</span></div></li>
        <li><div><b>הצנרת של הבניין</b><span>צינורות ברזל בני עשרות שנים מחלידים מבפנים. ראיתם פעם מים צהובים אחרי הפסקת מים? זה מה שיושב על הדפנות גם בשאר הימים, בכמות שלא רואים.</span></div></li>
        <li><div><b>הדוד</b><span>המים החמים של המקלחת עוברים דרכו. מתי ניקו אותו בפעם האחרונה? משקעים מצטברים בתחתית במשך שנים.</span></div></li>
        <li><div><b>המים שעמדו</b><span>המים הראשונים של הבוקר ישבו בצינור כל הלילה. אחרי חופשה, שבוע שלם.</span></div></li>
        <li><div><b>המקלחת</b><span>ומכאן זה נוחת ישר על העור והשיער שלהם. או על פילטר.</span></div></li>
      </ol>
      <p class="journey-e">אתם לא יכולים להחליף את הצנרת של הבניין. אתם כן יכולים להחליט מה יוצא ממנה.</p>
      {%- if chamber_img -%}
        <figure class="pipe-real pipe-chamber">
          <figcaption><b>התא השקוף, בצילום אמיתי</b></figcaption>
          <img src="{{ chamber_img | image_url: width: 800 }}" srcset="{{ chamber_img | image_url: width: 600 }} 600w, {{ chamber_img | image_url: width: 720 }} 720w, {{ chamber_img | image_url: width: 840 }} 840w, {{ chamber_img | image_url: width: 1120 }} 1120w" sizes="(min-width:901px) 560px, (min-resolution: 3dppx) 60vw, (min-resolution: 2.5dppx) 72vw, 92vw" width="{{ chamber_img.width }}" height="{{ chamber_img.height }}" loading="lazy" decoding="async" alt="התא השקוף של ראש המקלחת MALINVO, עם הפילטר הלבן גלוי בתוכו">
        </figure>
      {%- endif -%}
      {%- if real_img -%}
        <figure class="pipe-real">
          <img src="{{ real_img | image_url: width: 900 }}" width="{{ real_img.width }}" height="{{ real_img.height }}" loading="lazy" decoding="async" alt="{{ real_img.alt | default: 'פילטר MALINVO אחרי שימוש' | escape }}">
          {%- if real_cap != blank or real_title != blank -%}<figcaption>{%- if real_title != blank -%}<b>{{ real_title | escape }}</b>{%- endif -%}{{ real_cap | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endif -%}
      <a class="{% if cta_button %}btn{% else %}tlink{% endif %}" href="{{ pipe_buy }}" data-to-buy{% if cta_button %} data-cta{% endif %}>לבחירת חבילה</a>
    </div>
  </div>
</section>
