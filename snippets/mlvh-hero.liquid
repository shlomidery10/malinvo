{%- doc -%}
  MALINVO home hero: headline, one line naming the product, one button to the product page, one product photo (the LCP element).
  No price here: the price lives on the product page only.
  @param {string} url - Product page URL
  @param {image} [img_m] - Mobile photo (up to 900px)
  @param {image} [img_d] - Desktop photo
  @param {string} [fit] - contain (default) | cover
  @param {boolean} [blend] - Multiply the photo onto the cream background (for photos on a white backdrop)
  @example
  {% render 'mlvh-hero', url: product_url, img_m: section.settings.hero_image_m %}
{%- enddoc -%}
{%- assign him = img_m | default: img_d | default: images['malinvo_black_06_grip_scale.png'] -%}
{%- assign hid = img_d | default: img_m | default: images['malinvo_black_06_grip_scale.png'] -%}
{%- if him -%}
<!--mlv-preload-->
{%- if hid != him -%}<link rel="preload" as="image" fetchpriority="high" media="(min-width:901px)" imagesrcset="{{ hid | image_url: width: 900 }} 900w, {{ hid | image_url: width: 1400 }} 1400w" imagesizes="50vw">{%- endif -%}
<link rel="preload" as="image" fetchpriority="high"{% if hid != him %} media="(max-width:900.98px)"{% endif %} imagesrcset="{{ him | image_url: width: 360 }} 360w, {{ him | image_url: width: 480 }} 480w, {{ him | image_url: width: 640 }} 640w" imagesizes="(min-width:901px) 50vw, 100vw">
<!--mlv-preload-->
{%- endif -%}
<section class="hero" id="mlvh-hero" aria-labelledby="mlvh-h1">
  <div class="hero-in">
    <div class="hero-t">
      <h1 id="mlvh-h1">בחרתם להם את השמפו הכי עדין. ומה עם המים עצמם?</h1>
      <p class="hsub">MALINVO Nova, ראש מקלחת מסנן.</p>
      <a href="{{ url }}" class="btn" data-cta>לעמוד המוצר</a>
    </div>
    {%- if him -%}
      <div class="hero-m{% if fit == 'cover' %} is-cover{% endif %}{% if blend %} is-blend{% endif %}">
        <picture>
          {%- if hid != him -%}<source media="(min-width:901px)" srcset="{{ hid | image_url: width: 900 }} 900w, {{ hid | image_url: width: 1400 }} 1400w" sizes="50vw" width="{{ hid.width }}" height="{{ hid.height }}">{%- endif -%}
          <img src="{{ him | image_url: width: 640 }}" srcset="{{ him | image_url: width: 360 }} 360w, {{ him | image_url: width: 480 }} 480w, {{ him | image_url: width: 640 }} 640w" sizes="(min-width:901px) 50vw, 100vw" width="{{ him.width }}" height="{{ him.height }}" loading="eager" fetchpriority="high" decoding="async" alt="{{ him.alt | default: 'ראש המקלחת MALINVO Nova באחיזת יד, בחדר רחצה' | escape }}">
        </picture>
      </div>
    {%- endif -%}
  </div>
</section>
