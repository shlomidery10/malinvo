{%- doc -%}
  MALINVO home sticky CTA (mobile only). Shown while no [data-cta] element and no footer are on screen.
  Hidden (visibility:hidden, not focusable) otherwise, and never shown without JS.
  @param {string} buy_url - Product page bundle picker URL
  @param {string} from_price - Formatted "from" price
  @example
  {% render 'mlvh-sticky', buy_url: buy_url, from_price: from_price %}
{%- enddoc -%}
<a href="{{ buy_url }}" class="mlvh-sticky" id="mlvh-sticky" tabindex="-1" aria-hidden="true"><span class="mlvh-sticky__p">החל מ-<bdi>{{ from_price }}</bdi></span><span class="mlvh-sticky__c">לבחירת חבילה</span></a>
<script>
document.addEventListener('DOMContentLoaded',function(){
  var s=document.getElementById('mlvh-sticky');
  if(!s||!('IntersectionObserver' in window))return;
  var els=[].slice.call(document.querySelectorAll('#mlvh [data-cta], .page-wrapper > footer'));
  if(!els.length)return;
  var vis=new Set();
  function upd(){var on=vis.size===0;s.classList.toggle('on',on);if(on){s.removeAttribute('tabindex');s.removeAttribute('aria-hidden')}else{s.setAttribute('tabindex','-1');s.setAttribute('aria-hidden','true')}}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)vis.add(e.target);else vis.delete(e.target)});upd()},{rootMargin:'0px 0px 80px 0px',threshold:0});
  els.forEach(function(e){vis.add(e);io.observe(e)});
});
</script>
