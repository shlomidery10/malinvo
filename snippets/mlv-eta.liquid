{%- doc -%}
  Delivery estimate line for the product buy box, rendered as one <li> inside a list (e.g. ul.reass).
  Without JS it reads the policy wording ("עד 15 ימי עסקים"). With JS it shows an estimated arrival date range:
  today (Israel time) + 1-3 business days handling + 5-15 business days transit, business days Sun-Thu.
  No holiday logic and no arrival promise: the line says "משוערת".

  @param {number} [handling_min] - Handling business days, low end (default 1)
  @param {number} [handling_max] - Handling business days, high end (default 3)
  @param {number} [transit_min] - Transit business days, low end (default 5)
  @param {number} [transit_max] - Transit business days, high end (default 15)

  @example
  <ul class="reass">{% render 'mlv-eta' %}</ul>
{%- enddoc -%}
{%- liquid
  assign eta_min = handling_min | default: 1 | plus: 0
  assign eta_min = transit_min | default: 5 | plus: eta_min
  assign eta_max = handling_max | default: 3 | plus: 0
  assign eta_max = transit_max | default: 15 | plus: eta_max
-%}
<li class="mlv-eta" data-eta data-min="{{ eta_min }}" data-max="{{ eta_max }}">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  <span>משלוח חינם · <span data-eta-text>משלוח עד 15 ימי עסקים</span>, עם מספר מעקב</span>
</li>
<script>
  (function () {
    var li = document.currentScript.previousElementSibling;
    if (!li || !li.hasAttribute('data-eta') || !window.Intl) return;
    var out = li.querySelector('[data-eta-text]');
    try {
      /* Today's calendar date in Israel, then count business days (Sun-Thu) on a UTC date so DST never shifts it */
      var parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
      var get = function (t) { for (var i = 0; i < parts.length; i++) if (parts[i].type === t) return +parts[i].value; return NaN; };
      var base = Date.UTC(get('year'), get('month') - 1, get('day'));
      if (isNaN(base)) return;
      var addBiz = function (n) {
        var d = new Date(base);
        while (n > 0) { d.setUTCDate(d.getUTCDate() + 1); var w = d.getUTCDay(); if (w !== 5 && w !== 6) n--; }
        return d;
      };
      var fmt = function (d) { return d.getUTCDate() + '.' + (d.getUTCMonth() + 1); };
      var a = addBiz(+li.getAttribute('data-min')), b = addBiz(+li.getAttribute('data-max'));
      out.innerHTML = 'הגעה משוערת: <bdi dir="ltr">' + fmt(a) + '–' + fmt(b) + '</bdi>';
    } catch (e) {}
  })();
</script>
