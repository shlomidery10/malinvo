{%- comment -%}
  MALINVO announcement bar: a slow, continuous marquee on every page. Pure CSS (transform only), fixed height, no layout shift.
  The group of items is printed 6 times in one track and the track moves by exactly one group, so the loop has no seam.
  Only the first group is read by screen readers. RTL: the line moves to the right, so each item enters from its first word.
  Pauses on hover/focus. prefers-reduced-motion: one static centered line (short wording on narrow screens).
  "מחיר השקה עד 31.12" is dropped after 31.12.2026 (Israel time): by Liquid at render and by the small script for cached pages.
{%- endcomment -%}
{%- assign ann_now = 'now' | date: '%s' | plus: 0 -%}
{%- assign ann_launch = false -%}
{%- if ann_now < 1798754400 -%}{%- assign ann_launch = true -%}{%- endif -%}
{%- capture ann_grp -%}
<span class="mlv-ann__it"><svg class="mlv-ann__ic" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 4h8v6.5h-8zM9.5 6h2.6l2.4 2.2v2.3h-5"/><circle cx="4.6" cy="11.6" r="1.3"/><circle cx="11.6" cy="11.6" r="1.3"/></svg><span>משלוח חינם<span class="mlv-ann__x"> לכל הארץ</span></span></span><span aria-hidden="true" class="mlv-ann__sep">·</span>
<span class="mlv-ann__it"><svg class="mlv-ann__ic" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2.3" y="3.3" width="11.4" height="10.4" rx="1.6"/><path d="M2.3 6.8h11.4M5.6 1.9v2.6M10.4 1.9v2.6"/></svg><span>30 יום להחליט<span class="mlv-ann__x">, גם אחרי התקנה</span></span></span><span aria-hidden="true" class="mlv-ann__sep">·</span>
{%- if ann_launch -%}<span class="mlv-ann__it mlv-ann__x" data-ann-launch><svg class="mlv-ann__ic" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8.6 1.8H14.2V7.4L7.6 14 2 8.4z"/><circle cx="11.2" cy="4.8" r="1"/></svg><span>מחיר השקה עד 31.12</span></span><span aria-hidden="true" class="mlv-ann__sep mlv-ann__x" data-ann-launch>·</span>{%- endif -%}
<span class="mlv-ann__it"><svg class="mlv-ann__ic" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3.5h10A1.5 1.5 0 0 1 14.5 5v4.5A1.5 1.5 0 0 1 13 11H7.3l-3.1 2.4v-2.4H3A1.5 1.5 0 0 1 1.5 9.5V5A1.5 1.5 0 0 1 3 3.5z"/></svg><span>מענה בעברית</span></span><span aria-hidden="true" class="mlv-ann__sep mlv-ann__sep--end">·</span>
{%- endcapture -%}
<div class="mlv-ann" role="note">
  <div class="mlv-ann__track">
    <p class="mlv-ann__grp">{{ ann_grp }}</p>
    {%- for i in (1..5) -%}<p class="mlv-ann__grp mlv-ann__dup" aria-hidden="true">{{ ann_grp }}</p>{%- endfor -%}
  </div>
</div>
{%- if ann_launch -%}
<script>(function(){if(Date.now()>=Date.parse('2027-01-01T00:00:00+02:00'))[].slice.call(document.querySelectorAll('[data-ann-launch]')).forEach(function(e){e.remove()})})();</script>
{%- endif -%}

<style>
  .mlv-ann{display:flex;align-items:center;height:36px;background:#0e1d21;color:#f6efe8;font-family:var(--font-body--family);font-size:14px;font-weight:400;letter-spacing:.01em;line-height:1;overflow:hidden;direction:rtl;border-block-end:1px solid rgba(217,162,122,.22)}
  .mlv-ann__track{display:flex;flex:none;width:max-content;will-change:transform;animation:mlv-ann-run 28s linear infinite}
  .mlv-ann:hover .mlv-ann__track,.mlv-ann:focus-within .mlv-ann__track{animation-play-state:paused}
  .mlv-ann__grp{flex:none;margin:0;white-space:nowrap;display:flex;align-items:center}
  .mlv-ann__it{display:inline-flex;align-items:center;gap:7px}
  .mlv-ann__ic{flex:none;display:block;height:15px;width:auto}
  .mlv-ann__sep{flex:none;width:4px;height:4px;border-radius:50%;background:#d9a27a;margin-inline:18px;font-size:0}
  @keyframes mlv-ann-run{from{transform:translate3d(0,0,0)}to{transform:translate3d(calc(100% / 6),0,0)}}
  @media (max-width:359px){.mlv-ann{font-size:13px}.mlv-ann__ic{height:13px}}
  @media (prefers-reduced-motion:reduce){
    .mlv-ann{justify-content:center;padding-inline:12px}
    .mlv-ann__track{animation:none;will-change:auto;width:auto}
    .mlv-ann__dup,.mlv-ann__sep--end{display:none}
    .mlv-ann__sep{margin-inline:10px}
    .mlv-ann__it{gap:6px}
  }
  @media (prefers-reduced-motion:reduce) and (max-width:819px){.mlv-ann .mlv-ann__x{display:none}}
  @media (prefers-reduced-motion:reduce) and (max-width:359px){.mlv-ann__sep{margin-inline:6px}.mlv-ann__it{gap:5px}}
</style>
