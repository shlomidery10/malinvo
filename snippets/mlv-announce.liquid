{%- comment -%} MALINVO announcement bar: one fixed line, the same text at every width and on every page. Small inline-SVG icon before each item. No rotation, no script. {%- endcomment -%}
<div class="mlv-ann" role="note">
  <p class="mlv-ann__line">
    <span class="mlv-ann__it"><svg class="mlv-ann__ic mlv-ann__ic--flag" viewBox="0 0 22 16" aria-hidden="true"><rect x=".5" y=".5" width="21" height="15" rx="2" fill="#fff"/><rect x=".5" y="2.7" width="21" height="2.3" fill="#0038b8"/><rect x=".5" y="11" width="21" height="2.3" fill="#0038b8"/><path d="M11 5.1l1.75 3.05h-3.5zM11 10.9l-1.75-3.05h3.5z" fill="none" stroke="#0038b8" stroke-width=".95"/></svg><span>מותג ישראלי</span></span>
    <span aria-hidden="true" class="mlv-ann__sep">·</span>
    <span class="mlv-ann__it"><svg class="mlv-ann__ic" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3.5h10A1.5 1.5 0 0 1 14.5 5v4.5A1.5 1.5 0 0 1 13 11H7.3l-3.1 2.4v-2.4H3A1.5 1.5 0 0 1 1.5 9.5V5A1.5 1.5 0 0 1 3 3.5z"/></svg><span>מענה בעברית</span></span>
    <span aria-hidden="true" class="mlv-ann__sep">·</span>
    <span class="mlv-ann__it"><svg class="mlv-ann__ic" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3.3" y="7" width="9.4" height="6.6" rx="1.5"/><path d="M5.4 7V5.1a2.6 2.6 0 0 1 5.2 0V7"/></svg><span>תשלום מאובטח</span></span>
  </p>
</div>

<style>
  .mlv-ann{display:flex;align-items:center;justify-content:center;height:36px;padding-inline:12px;background:#0e1d21;color:#f6efe8;font-family:var(--font-body--family);font-size:14px;font-weight:400;letter-spacing:.01em;line-height:1;overflow:hidden;direction:rtl;border-block-end:1px solid rgba(217,162,122,.22)}
  .mlv-ann__line{margin:0;white-space:nowrap;display:inline-flex;align-items:center}
  .mlv-ann__it{display:inline-flex;align-items:center;gap:6px}
  .mlv-ann__ic{flex:none;display:block;height:15px;width:auto}
  .mlv-ann__sep{color:#d9a27a;margin-inline:9px}
  @media (max-width:359px){.mlv-ann{font-size:13px}.mlv-ann__ic{height:13px}.mlv-ann__sep{margin-inline:6px}.mlv-ann__it{gap:5px}}
</style>
