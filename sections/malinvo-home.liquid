{%- comment -%}
  MALINVO home. One product, and the ads land on the product page, so this page only has to look right and hand
  the visitor over: hero, trust row, three steps (only when all three step photos are set), closing. No prices
  here: the price lives on the product page only. Every image comes from the section settings.
  The other home snippets (strip, pipe, close, offer, compare, faq, sticky) are kept in the theme but not rendered.
{%- endcomment -%}
{%- comment -%} Handle-independent product lookup: 1) section setting, 2) product id via collections.all, 3) handle fallback. {%- endcomment -%}
{%- assign p = section.settings.product -%}
{%- if p == blank -%}
  {%- for cp in collections.all.products -%}
    {%- if cp.id == 10898707939493 -%}{%- assign p = cp -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if p == blank -%}{%- assign p = all_products['malinvo-nova'] -%}{%- endif -%}
{%- assign purl = p.url | default: '/products/malinvo-nova' -%}
{%- assign s = section.settings -%}

{% render 'mlv-sections-css' %}

<div id="mlvh">
  {% render 'mlvh-hero', url: purl, img_m: s.hero_image_m, img_d: s.hero_image_d, fit: s.hero_fit, blend: s.hero_blend %}
  {% render 'mlvh-trust' %}
  {%- if s.step1_image and s.step2_image and s.step3_image -%}
    {% render 'mlv-steps', img1: s.step1_image, img2: s.step2_image, img3: s.step3_image, section_id: 'mlvh-steps', no_placeholder: true %}
  {%- endif -%}
  {% render 'mlvh-final', url: purl, img_m: s.final_image_m, img_d: s.final_image_d %}
</div>
{% render 'mlv-img-loader' %}

{% schema %}
{
  "name": "MALINVO home",
  "tag": "section",
  "settings": [
    {"type": "product", "id": "product", "label": "Product (optional - falls back to product id 10898707939493)"},
    {"type": "header", "content": "Hero"},
    {"type": "image_picker", "id": "hero_image_m", "label": "Hero photo, mobile (H1, 1080x1320)"},
    {"type": "image_picker", "id": "hero_image_d", "label": "Hero photo, desktop (H1, 1400x1500)"},
    {"type": "select", "id": "hero_fit", "label": "Hero photo fit", "options": [{"value": "contain", "label": "Contain (whole photo)"}, {"value": "cover", "label": "Cover (fills the area, crops)"}], "default": "contain"},
    {"type": "checkbox", "id": "hero_blend", "label": "Blend photo into cream background (white-backdrop photos)", "default": false},
    {"type": "header", "content": "Three steps (needs all 3 photos)"},
    {"type": "image_picker", "id": "step1_image", "label": "Step 1 (S1, 600x600)"},
    {"type": "image_picker", "id": "step2_image", "label": "Step 2 (S1, 600x600)"},
    {"type": "image_picker", "id": "step3_image", "label": "Step 3 (S1, 600x600)"},
    {"type": "header", "content": "Closing section"},
    {"type": "image_picker", "id": "final_image_m", "label": "Closing photo, mobile (F1, 1080x840)"},
    {"type": "image_picker", "id": "final_image_d", "label": "Closing photo, desktop (F1, 1920x800)"}
  ],
  "presets": [{"name": "MALINVO home"}]
}
{% endschema %}
