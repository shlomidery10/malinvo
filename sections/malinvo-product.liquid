<div id="mlv">
  <section class="hero">
    <div class="w">
      <div class="gal">
        {%- comment -%}
          Gallery plan (decisions.md, 8 branded 1:1 slides). m|<product media id>|  or  f|<file in Files>|<alt>.
          Order: 1 lifestyle, 2 in the set, 3 chamber, 4 in hand, 5 callouts, 6 install, 7 comparison, 8 set + 5 filters.
        {%- endcomment -%}
        {%- comment -%} New product (oval filter): gallery uses the product's own uploaded media, in Shopify order, with each media's Hebrew alt text. {%- endcomment -%}
        {%- assign gal_spec = '' -%}
        {%- comment -%} Color swap: the hero of every non-default variant is kept out of the slide list; choosing that color swaps slide 1 to it (see "hero color swap" script). {%- endcomment -%}
        {%- assign alt_hero = null -%}{%- assign alt_hero_color = '' -%}
        {%- for v in product.variants -%}{%- unless forloop.first -%}{%- if v.featured_media and v.featured_media.id != product.variants.first.featured_media.id -%}{%- assign alt_hero = v.featured_media -%}{%- assign alt_hero_color = v.option1 -%}{%- endif -%}{%- endunless -%}{%- endfor -%}
        {%- for m in product.media -%}{%- unless alt_hero and m.id == alt_hero.id -%}{%- assign gal_spec = gal_spec | append: 'm|' | append: m.id | append: '|;;' -%}{%- endunless -%}{%- endfor -%}
        {%- if alt_hero -%}
        {%- capture alt_srcset -%}{{ alt_hero.preview_image | image_url: width: 600 }} 600w, {{ alt_hero.preview_image | image_url: width: 750 }} 750w, {{ alt_hero.preview_image | image_url: width: 900 }} 900w, {{ alt_hero.preview_image | image_url: width: 1000 }} 1000w, {{ alt_hero.preview_image | image_url: width: 1200 }} 1200w{%- endcapture -%}
        <script type="application/json" data-hero-alt>{"color":{{ alt_hero_color | json }},"alt":{{ alt_hero.alt | json }},"src":{{ alt_hero.preview_image | image_url: width: 1200 | json }},"thumb":{{ alt_hero.preview_image | image_url: width: 140 | json }},"srcset":{{ alt_srcset | json }}}</script>
        {%- endif -%}
        {%- assign gal_spec = gal_spec | split: ';;' -%}
        {%- assign gal_ok = '' -%}
        {%- for it in gal_spec -%}
          {%- assign gp = it | split: '|' -%}
          {%- if gp[0] == 'm' -%}
            {%- assign gnum = gp[1] | plus: 0 -%}
            {%- assign gm = product.media | where: 'id', gnum | first -%}
            {%- if gm -%}{%- assign gal_ok = gal_ok | append: it | append: ';;' -%}{%- endif -%}
          {%- else -%}
            {%- assign gal_ok = gal_ok | append: it | append: ';;' -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign gal = gal_ok | split: ';;' -%}
        {%- assign gsizes = "(min-width: 1200px) 600px, (min-width: 900px) 52vw, (min-resolution: 3dppx) 64vw, (min-resolution: 2.5dppx) 78vw, 100vw" -%}
        {%- if gal.size > 0 -%}
        <div class="track" data-track role="region" aria-roledescription="קרוסלה" aria-label="תמונות המוצר" tabindex="0">
          {%- for it in gal -%}
            {%- assign gp = it | split: '|' -%}
            <figure class="slide" id="mlv-s{{ forloop.index }}">
              {%- if gp[0] == 'm' -%}
                {%- assign gnum = gp[1] | plus: 0 -%}
                {%- assign gm = product.media | where: 'id', gnum | first -%}
                {%- assign galt = gm.alt | default: 'ראש מקלחת MALINVO עם פילטר מתחלף' -%}
                {%- if gm.media_type == 'video' -%}
                  {{ gm | video_tag: controls: true, muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '900x' }}
                {%- elsif forloop.first -%}
                  {{ gm.preview_image | image_url: width: 1200 | image_tag: widths: '600,750,900,1000,1200', sizes: gsizes, fetchpriority: 'high', loading: 'eager', alt: galt }}
                {%- else -%}
                  {{ gm.preview_image | image_url: width: 1200 | image_tag: widths: '600,750,900,1000,1200', sizes: gsizes, loading: 'lazy', decoding: 'async', alt: galt }}
                {%- endif -%}
              {%- else -%}
                {%- assign gu = fb | append: gp[1] -%}
                <img src="{{ gu }}&width=1000" srcset="{{ gu }}&width=600 600w, {{ gu }}&width=750 750w, {{ gu }}&width=900 900w, {{ gu }}&width=1000 1000w" sizes="{{ gsizes }}" width="1000" height="1000" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async" alt="{{ gp[2] | escape }}">
              {%- endif -%}
            </figure>
          {%- endfor -%}
        </div>
        {%- endif -%}
        {%- if gal.size > 1 -%}
          <div class="dots" aria-hidden="true">{%- for it in gal -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}</div>
          <div class="thumbs">
            {%- for it in gal -%}
              {%- assign gp = it | split: '|' -%}
              {%- assign th_num = gp[1] | plus: 0 -%}{%- assign th_m = product.media | where: 'id', th_num | first -%}<button type="button" class="th{% if th_m.media_type == 'video' %} is-vid{% endif %}" data-to="{{ forloop.index0 }}" aria-label="תמונה {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
                {%- if gp[0] == 'm' -%}
                  {%- assign gnum = gp[1] | plus: 0 -%}
                  {%- assign gm = product.media | where: 'id', gnum | first -%}
                  {{- gm.preview_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: '' -}}
                {%- else -%}
                  <img src="{{ fb }}{{ gp[1] }}&width=140" width="140" height="140" loading="lazy" decoding="async" alt="">
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="buy" id="mlv-buy">
        {%- assign nova_logo = images['malinvo_logo_dark.png'] -%}
        <h1 class="mlv-lockup" dir="ltr">
          {%- if nova_logo -%}<img class="mlv-logo" src="{{ nova_logo | image_url: width: 360 }}" srcset="{{ nova_logo | image_url: width: 180 }} 180w, {{ nova_logo | image_url: width: 360 }} 360w, {{ nova_logo | image_url: width: 540 }} 540w" sizes="180px" alt="MALINVO" width="{{ nova_logo.width }}" height="{{ nova_logo.height }}" loading="eager" decoding="async">{%- else -%}<span class="mlv-lockup__word">MALINVO</span>{%- endif -%}
          <span class="mlv-sep" aria-hidden="true"></span>
          <span class="mlv-nova">Nova<span class="mlv-tm">&trade;</span></span>
        </h1>
        <p class="mlv-tag">ראש מקלחת עם פילטר לילדים ולכם.</p>
        <p class="mlv-sub">החול והחלודה מהצנרת נשארים בפילטר, לא במים שעליכם.</p>
        <a class="mlv-vouch-badge" href="#mlv-reviews" data-vouch-badge hidden>
          <span class="mlv-vouch-stars" aria-hidden="true"><span class="mlv-vouch-fill">★★★★★</span>★★★★★</span>
          <b class="mlv-vouch-avg"></b>
          <span class="mlv-vouch-count"></span>
        </a>
        <ul class="mlv-usp">
          <li><div><b>תופס את מה שהצנרת מוסיפה.</b> חול, חלודה ומשקעים נתפסים בפילטר, והכלור השיורי מופחת.</div></li>
          <li><div><b>העיצוב שמעצבות פנים בוחרות.</b> קווים נקיים, גימור מט, בשחור או בלבן, שמתאימים לכל חדר רחצה.</div></li>
          <li><div><b>זרם מלא וצפוף.</b> חורים זעירים מרכזים את המים, בלי לשנות את הלחץ בבית.</div></li>
          <li><div><b>מתקינים בדקה.</b> מבריגים לצינור המקלחת הקיים, בלי כלים ובלי אינסטלטור.</div></li>
          <li><div><b>מרגישים מהמקלחת הראשונה.</b> פחות ריח של כלור, ומים שנעים לעמוד תחתם.</div></li>
        </ul>
        {%- comment -%} Launch price: the regular price (compare-at) is real and takes effect on 1.1.2027; until then the line says so explicitly. Renders only while compare-at > price. {%- endcomment -%}
        {%- if cur.compare_at_price > cur.price -%}
        <p class="mlv-price"><s class="mlv-price__was"><bdi>₪{{ cur.compare_at_price | money_without_currency }}</bdi></s><b class="mlv-price__now"><bdi>₪{{ cur.price | money_without_currency }}</bdi></b><span class="mlv-price__note">· מחיר השקה עד 31.12.2026</span></p>
        {%- endif -%}
        <form method="post" action="/cart/add" class="shopify-product-form" id="mlv-form">
          <input type="hidden" name="id" value="{{ cur.id }}">
          <div class="product-form__buttons"><button type="submit" name="add" class="btn"{% unless cur.available %} disabled{% endunless %}>להוספה לעגלה</button></div>
        </form>
        <p class="buy-note">30 יום להחליט, מיום שהמוצר אצלכם. <a href="/pages/refund-policy">לתנאי ההחזרה המלאים</a>.</p>
        {%- comment -%} Risk-reversal near CTA. Shipping from 10_SHIPPING; returns 30d approved by owner; warranty = placeholder. {%- endcomment -%}
        <ul class="reass">
